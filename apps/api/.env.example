# Database: PostgreSQL. Locally, `docker compose up -d db` and:
DATABASE_URL="postgresql://vetify:vetify@localhost:5432/vetify"
# Only needed to check migrations with `prisma migrate diff --from-migrations`.
# SHADOW_DATABASE_URL="postgresql://vetify:vetify@localhost:5432/vetify_shadow"

# Secrets, at least 32 characters each. Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET=""
JWT_REFRESH_TTL="30d"
LINK_CODE_SECRET=""

PORT=3001
# Browser origins allowed to call the API (comma separated). Cookie
# endpoints reject any other Origin.
ALLOWED_ORIGINS="http://localhost:3000"
# Trust 1 only after verifying the last ingress proxy overwrites forwarding
# headers on EVERY public route. Never count Vercel + Render as 2: the direct
# Render URL is a shorter route and could allow forged client IPs.
TRUST_PROXY_HOPS=0
# For multiple proxies, trust only their actual IPs/CIDRs (takes precedence).
# Do not use 0.0.0.0/0 or ::/0. If ranges are not stable, keep one verified
# ingress boundary and accept conservative shared limits rather than forged IPs.
# TRUST_PROXY_CIDRS="10.0.0.10/32"
# Scalar at /api/docs. Defaults to on outside production, off in production.
# API_DOCS_ENABLED=true

# Notification worker: enable on at least one long-running API instance.
# It creates owner inbox reminders even when push is not configured.
NOTIFICATIONS_WORKER_ENABLED=false
# Web Push VAPID keys and a valid contact URI, e.g. mailto:ops@example.com.
# Generate a stable keypair with the web-push CLI; keep the private key secret.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
# Development only: expose the authenticated, rate-limited test-push endpoint.
DEV_PUSH_TEST_ENABLED=false

# Tilopay payments (Admin panel · Platform integrations). Leave empty to turn
# billing off. Test mode is switched on in the Tilopay dashboard; with
# TILOPAY_ENVIRONMENT=test the API only accepts payments Tilopay reports as test.
TILOPAY_API_USER=""
TILOPAY_PASSWORD=""
TILOPAY_KEY=""
TILOPAY_ENVIRONMENT=test
