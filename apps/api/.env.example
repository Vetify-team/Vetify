# Base de datos — PostgreSQL gestionado en Neon.
# Copiar el connection string "pooled" del panel de Neon.
DATABASE_URL="postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/vetify?sslmode=require"

# Secretos de JWT. Generar cada uno con: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET=""
JWT_REFRESH_TTL="30d"

# Puerto del API y origen permitido para CORS (el frontend Next.js).
PORT=3001
CORS_ORIGIN="http://localhost:3000"
