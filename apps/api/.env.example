# Database: PostgreSQL. Locally, `docker compose up -d db` and:
DATABASE_URL="postgresql://vetify:vetify@localhost:5432/vetify"
# Only needed to check migrations with `prisma migrate diff --from-migrations`.
# SHADOW_DATABASE_URL="postgresql://vetify:vetify@localhost:5432/vetify_shadow"

# Secrets, at least 32 characters each. Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET=""
JWT_REFRESH_TTL="30d"
LINK_CODE_SECRET=""

PORT=3001
# Browser origins allowed to call the API (comma separated). Cookie
# endpoints reject any other Origin.
ALLOWED_ORIGINS="http://localhost:3000"
# Trust 1 only after verifying the last ingress proxy overwrites forwarding
# headers on EVERY public route. Never count Vercel + Render as 2: the direct
# Render URL is a shorter route and could allow forged client IPs.
TRUST_PROXY_HOPS=0
# For multiple proxies, trust only their actual IPs/CIDRs (takes precedence).
# Do not use 0.0.0.0/0 or ::/0. If ranges are not stable, keep one verified
# ingress boundary and accept conservative shared limits rather than forged IPs.
# TRUST_PROXY_CIDRS="10.0.0.10/32"
# Scalar at /api/docs. Defaults to on outside production, off in production.
# API_DOCS_ENABLED=true

# Notification worker: enable on at least one long-running API instance.
# It creates owner inbox reminders even when push is not configured.
NOTIFICATIONS_WORKER_ENABLED=false
# Web Push VAPID keys and a valid contact URI, e.g. mailto:ops@example.com.
# Generate a stable keypair with the web-push CLI; keep the private key secret.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""
# Development only: expose the authenticated, rate-limited test-push endpoint.
DEV_PUSH_TEST_ENABLED=false

# ONVO payments (Dashboard · Developers). Leave empty to turn billing off and
# lift the free plan's pet limit. Vetify is academic: staging and production use
# an onvo_test_ key, which never touches real money (test cards only).
ONVO_SECRET_KEY=""
# Optional and unused today: no webhook is registered, payments settle from
# /pago and when the plan is shown. Only needed if an endpoint is registered in
# the Dashboard at <API>/api/v1/billing/webhooks/onvo; empty rejects every call.
ONVO_WEBHOOK_SECRET=""

# Pet photos and exam files (Cloudinary · Settings · API Keys · "API environment
# variable"). Only the API holds it; browsers get one-file upload signatures.
# Empty: uploads and file links answer 503 UPLOADS_UNAVAILABLE.
CLOUDINARY_URL=""

# OpenTelemetry (traces, metrics, logs over OTLP/HTTP). Off while the endpoint
# is empty. Grafana Cloud: Home · Connections · OpenTelemetry (OTLP) gives the
# endpoint and an "Authorization=Basic …" header; keep the header secret.
# OTEL_EXPORTER_OTLP_ENDPOINT="https://otlp-gateway-prod-us-east-0.grafana.net/otlp"
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64 instance:token>"
# OTEL_SERVICE_NAME=vetify-api
# OTEL_RESOURCE_ATTRIBUTES="deployment.environment.name=staging"

# Account emails (password reset) through Resend. Leave empty to send nothing:
# development prints the email to the log instead. The sender domain must be
# verified in Resend.
RESEND_API_KEY=""
# MAIL_FROM="Vetify <noreply@vetify.live>"
# Owner app origin for the links in reminder emails (for example https://app.vetify.live).
OWNER_APP_URL=""

# Pet assistant: any OpenAI-compatible chat completions API with function
# calling. Leave the key empty to turn the assistant off (503 ASSISTANT_DISABLED).
# Gemini: LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
# with a model such as gemini-2.5-flash. Only the API holds the key.
LLM_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com"
LLM_MODEL="deepseek-chat"
# Owner messages per calendar month on the free plan (only while payments are on).
ASSISTANT_FREE_MONTHLY_MESSAGES=30
