// Vetify data model.
//
// Prisma fields are camelCase; tables and columns are snake_case through
// @map/@@map. Authorization is not modeled here (there is no row-level
// security): it is enforced by the API services, starting with
// PermissionsService.authorize.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

/// `admin` is never self-assigned: admins are created with a server script.
enum UserRole {
  owner
  clinic
  admin

  @@map("user_role")
}

enum Species {
  dog
  cat
  other

  @@map("species")
}

enum AnimalSex {
  male
  female

  @@map("animal_sex")
}

enum PermissionStatus {
  active
  revoked
  pending

  @@map("permission_status")
}

/// `full` gives access to the whole record; `card_only`, only to vaccine validity.
enum PermissionScope {
  full
  card_only

  @@map("permission_scope")
}

enum Severity {
  low
  medium
  high

  @@map("severity")
}

// ---------- Accounts and roles ----------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  role         UserRole @default(owner)
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  pets               Pet[]
  clinicStaff        ClinicStaff[]
  consultations      Consultation[]
  sessions           RefreshSession[]
  accessLogs         AccessLog[]
  idempotencyResults IdempotencyResult[]

  @@map("users")
}

/// Rotated refresh tokens. Only the hash is stored, never the token itself.
model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

model Clinic {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  address    String?
  country    String    @default("CR")
  plan       String    @default("pilot")
  vetCount   Int       @default(1) @map("vet_count")
  /// Reviewed by an admin. Only verified clinics can issue link codes.
  verified   Boolean   @default(false)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  staff         ClinicStaff[]
  linkCodes     ClinicLinkCode[]
  consultations Consultation[]
  vaccinations  Vaccination[]
  permissions   Permission[]

  @@map("clinics")
}

model ClinicStaff {
  id       String @id @default(uuid()) @db.Uuid
  clinicId String @map("clinic_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  position String @default("veterinarian")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clinicId, userId])
  @@map("clinic_staff")
}

/// Single-use code a verified clinic shows the owner in person; the owner
/// types it to grant access. Only an HMAC of the code is stored.
model ClinicLinkCode {
  id           String    @id @default(uuid()) @db.Uuid
  clinicId     String    @map("clinic_id") @db.Uuid
  codeHash     String    @unique @map("code_hash")
  createdById  String    @map("created_by_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  usedForPetId String?   @map("used_for_pet_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId])
  @@map("clinic_link_codes")
}

// ---------- The pet's record ----------

model Pet {
  id        String     @id @default(uuid()) @db.Uuid
  ownerId   String     @map("owner_id") @db.Uuid
  name      String
  species   Species
  breed     String?
  sex       AnimalSex?
  birthDate DateTime?  @map("birth_date") @db.Date
  neutered  Boolean    @default(false)
  microchip String?
  photoUrl  String?    @map("photo_url")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  owner          User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  consultations  Consultation[]
  vaccinations   Vaccination[]
  dewormings     Deworming[]
  treatments     Treatment[]
  exams          Exam[]
  weightEntries  WeightEntry[]
  feedingEntries FeedingEntry[]
  permissions    Permission[]
  accessLogs     AccessLog[]
  reminders      Reminder[]
  anomalies      Anomaly[]

  @@index([ownerId])
  @@map("pets")
}

model Consultation {
  id             String   @id @default(uuid()) @db.Uuid
  petId          String   @map("pet_id") @db.Uuid
  clinicId       String?  @map("clinic_id") @db.Uuid
  veterinarianId String?  @map("veterinarian_id") @db.Uuid
  date           DateTime @default(now()) @db.Timestamptz(6)
  reason         String?
  diagnosis      String?
  notes          String?

  pet          Pet         @relation(fields: [petId], references: [id], onDelete: Cascade)
  clinic       Clinic?     @relation(fields: [clinicId], references: [id])
  veterinarian User?       @relation(fields: [veterinarianId], references: [id])
  treatments   Treatment[]

  @@index([petId])
  @@index([petId, date(sort: Desc), id(sort: Desc)])
  @@map("consultations")
}

model Vaccination {
  id        String    @id @default(uuid()) @db.Uuid
  petId     String    @map("pet_id") @db.Uuid
  vaccine   String
  batch     String?
  appliedOn DateTime  @map("applied_on") @db.Date
  expiresOn DateTime? @map("expires_on") @db.Date
  clinicId  String?   @map("clinic_id") @db.Uuid

  pet    Pet     @relation(fields: [petId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation(fields: [clinicId], references: [id])

  @@index([petId])
  @@index([petId, appliedOn(sort: Desc), id(sort: Desc)])
  @@map("vaccinations")
}

model Deworming {
  id        String    @id @default(uuid()) @db.Uuid
  petId     String    @map("pet_id") @db.Uuid
  product   String?
  /// internal / external
  kind      String?
  appliedOn DateTime  @map("applied_on") @db.Date
  nextDueOn DateTime? @map("next_due_on") @db.Date

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([petId, appliedOn(sort: Desc), id(sort: Desc)])
  @@index([petId, kind, appliedOn(sort: Desc), id(sort: Desc)])
  @@map("dewormings")
}

model Treatment {
  id             String    @id @default(uuid()) @db.Uuid
  consultationId String?   @map("consultation_id") @db.Uuid
  petId          String    @map("pet_id") @db.Uuid
  description    String
  startsOn       DateTime? @map("starts_on") @db.Date
  endsOn         DateTime? @map("ends_on") @db.Date

  consultation Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  pet          Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([petId, startsOn(sort: Desc), id(sort: Desc)])
  @@map("treatments")
}

model Exam {
  id          String   @id @default(uuid()) @db.Uuid
  petId       String   @map("pet_id") @db.Uuid
  kind        String?
  performedOn DateTime @map("performed_on") @db.Date
  fileUrl     String?  @map("file_url")
  result      String?

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([petId, performedOn(sort: Desc), id(sort: Desc)])
  @@map("exams")
}

model WeightEntry {
  id         String   @id @default(uuid()) @db.Uuid
  petId      String   @map("pet_id") @db.Uuid
  recordedOn DateTime @default(now()) @map("recorded_on") @db.Date
  weightKg   Decimal  @map("weight_kg") @db.Decimal(6, 2)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, recordedOn])
  @@index([petId, recordedOn(sort: Desc), id(sort: Desc)])
  @@map("weight_entries")
}

model FeedingEntry {
  id         String   @id @default(uuid()) @db.Uuid
  petId      String   @map("pet_id") @db.Uuid
  recordedOn DateTime @default(now()) @map("recorded_on") @db.Date
  notes      String?

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([petId, recordedOn(sort: Desc), id(sort: Desc)])
  @@map("feeding_entries")
}

// ---------- Business and security rules ----------

/// Preventive schedule per country / species / age. Global read-only catalog;
/// the API manages it.
model VaccinationRule {
  id                    String  @id @default(uuid()) @db.Uuid
  country               String
  species               Species
  vaccine               String
  minAgeMonths          Int?    @map("min_age_months")
  boosterIntervalMonths Int?    @map("booster_interval_months")
  /// How long the protection lasts
  validityMonths        Int     @map("validity_months")

  @@index([country, species])
  @@map("vaccination_rules")
}

/// Owner -> clinic consent. Revocable: revoking cuts access immediately.
/// It is the basis of all record authorization.
model Permission {
  id        String           @id @default(uuid()) @db.Uuid
  petId     String           @map("pet_id") @db.Uuid
  clinicId  String           @map("clinic_id") @db.Uuid
  scope     PermissionScope  @default(full)
  status    PermissionStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  pet    Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)
  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([petId, clinicId])
  @@index([clinicId, status])
  @@map("permissions")
}

/// Immutable audit log: rows are only inserted and read, never updated or deleted.
model AccessLog {
  id         String   @id @default(uuid()) @db.Uuid
  petId      String   @map("pet_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  pet  Pet   @relation(fields: [petId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([petId, occurredAt])
  /// Supports skipping repeated identical entries within a short window.
  @@index([petId, userId, action, occurredAt])
  @@map("access_logs")
}

model Reminder {
  id      String   @id @default(uuid()) @db.Uuid
  petId   String   @map("pet_id") @db.Uuid
  /// vaccination / deworming / weight
  kind    String
  dueOn   DateTime @map("due_on") @db.Date
  channel String   @default("push")
  status  String   @default("pending")

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, status])
  @@map("reminders")
}

/// Output of the AI module (weight anomalies for now).
model Anomaly {
  id         String   @id @default(uuid()) @db.Uuid
  petId      String   @map("pet_id") @db.Uuid
  /// e.g. 'weight'
  kind       String
  severity   Severity @default(medium)
  confidence Decimal? @db.Decimal(4, 3)
  details    String?
  detectedAt DateTime @default(now()) @map("detected_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@map("anomalies")
}

/// Successful write responses retained for a bounded 24-hour retry window.
model IdempotencyResult {
  userId      String   @map("user_id") @db.Uuid
  scope       String   @db.VarChar(128)
  keyHash     String   @map("key_hash") @db.Char(64)
  fingerprint String   @db.Char(64)
  response    Json     @db.JsonB
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, scope, keyHash])
  @@index([expiresAt])
  @@map("idempotency_results")
}
