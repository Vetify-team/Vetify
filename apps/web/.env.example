# Vetify API (NestJS). Server-side only: Next forwards /api/* there, so the
# browser always talks to this same origin. On Vercel, the Render URL.
API_ORIGIN="http://localhost:3001"

# Web Push keys are configured on the API, not in the web environment.
# Development only: register a no-cache service worker for real push tests.
NEXT_PUBLIC_DEV_PUSH_TEST_ENABLED=false
