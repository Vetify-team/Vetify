# Vetify API (NestJS). Server-side only: Next forwards /api/* there, so the
# browser always talks to this same origin. On Vercel, the Render URL.
API_ORIGIN="http://localhost:3001"

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
