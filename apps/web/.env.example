# Vetify API (NestJS). Server-side only: Next forwards /api/* there, so the
# browser always talks to this same origin. On Vercel, the Render URL.
API_ORIGIN="http://localhost:3001"

# Web Push keys are configured on the API, not in the web environment.
# Development only: register a no-cache service worker for real push tests.
NEXT_PUBLIC_DEV_PUSH_TEST_ENABLED=false

# Public URLs of the three sites served by this app (see src/lib/sites.ts).
# Leave them empty locally: every page is then served on localhost.
# Production: https://www.vetify.live, https://app.vetify.live, https://clinica.vetify.live
# Staging:    https://stg.vetify.live, https://app.stg.vetify.live, https://clinica.stg.vetify.live
NEXT_PUBLIC_SITE_URL=""
NEXT_PUBLIC_OWNER_URL=""
NEXT_PUBLIC_CLINIC_URL=""
