{
  "name": "vetify",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "prettier": "^3.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "@vetify/config": "workspace:*"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  }
}
