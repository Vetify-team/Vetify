{
  "extends": "@vetify/config/tsconfig.base.json",
  "compilerOptions": {
    // ESM con nodenext: es lo que consume apps/api (NestJS 12 es ESM) y
    // Next.js lo resuelve sin problema.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"]
}
