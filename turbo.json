{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "API_ORIGIN",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_OWNER_URL",
        "NEXT_PUBLIC_CLINIC_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["SECURITY_TEST_DATABASE_URL"],
      "outputs": []
    }
  }
}
